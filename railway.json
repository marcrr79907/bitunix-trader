{
  "$schema": "https://railway.app/railway.schema.json",
  "_comment": "One repo, three Railway services sharing this Dockerimage. Railway builds once and each service overrides its Start Command (see services below) in the dashboard / per-service config. `deploy.startCommand` here is the web default.",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000}",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "services": {
    "web": {
      "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000}",
      "healthcheckPath": "/healthz"
    },
    "worker": {
      "startCommand": "python web/worker.py"
    },
    "scheduler": {
      "startCommand": "python web/scheduler.py"
    }
  }
}
