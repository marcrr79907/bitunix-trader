# Copy to .env and fill in. Never commit .env.
#
# BitUnix API key — read-only, NO withdrawal permission, IP whitelist.
# Leave empty to run in public-only mode (market data, no private panels).
BITUNIX_API_KEY=
BITUNIX_API_SECRET=

# Optional: override tracked symbols (comma separated).
# Default: BTCUSDT,ETHUSDT,SOLUSDT,1000PEPEUSDT
BITUNIX_SYMBOLS=

# Telegram alerts (Etapa 6). Get token from @BotFather.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Django web (web/) ---
# Required in prod; dev falls back to an insecure local key when unset.
SECRET_KEY=
# PostgreSQL connection (prod). Local dev falls back to sqlite when unset.
DATABASE_URL=
# Redis for cache/queue (worker). Falls back to in-memory when unset.
REDIS_URL=
# "true"/"1" enables debug; default off. Dev module defaults to true.
DEBUG=
# Comma-separated hostnames the web service accepts.
ALLOWED_HOSTS=
# Comma-separated origins allowed to POST with CSRF (full scheme+host), e.g.
# https://your-app.up.railway.app. Required behind Railway's HTTPS proxy.
CSRF_TRUSTED_ORIGINS=
# Settings module for manage.py / wsgi. Default: config.settings.dev
DJANGO_SETTINGS_MODULE=

# Fernet key for exchange-credential encryption (worker trust zone only).
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes existing ciphertext undecryptable — back it up.
CREDENTIALS_FERNET_KEY=
